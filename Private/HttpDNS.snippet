#!name=🚫 Block HTTPDNS
#!desc=拦截常见 App 的 HTTPDNS 请求，促使客户端 SDK 回退系统 DNS (配合 aliyun-doh / MosDNS 使用)
#!author=VirgilClyne, ssxxs1
#!homepage=https://github.com/ssxxs1/geosite
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Server.png

# =============================================================
# 原项目致谢与引用来源 (Upstream Reference & Credits):
# 本规则集基于 VirgilClyne 的开源项目 GetSomeFries 改写与深度优化：
# - 原项目地址: https://github.com/VirgilClyne/GetSomeFries
# - 原始 Snippet: https://github.com/VirgilClyne/GetSomeFries/raw/main/snippets/HTTPDNS.Block.snippet
# - 原始 Ruleset: https://github.com/VirgilClyne/GetSomeFries/raw/main/ruleset/HTTPDNS.Block.list
# 谨向原作者 VirgilClyne 为社区做出的卓越工作与基础规则收集致以崇高敬意！
# =============================================================
#
# -------------------------------------------------------------
# 【架构原理指南】什么时候用 reject、reject-200、reject-dict？
# -------------------------------------------------------------
#
# 1. 什么时候用 url reject (HTTP 404 / TCP RST)？
#    - 【适用场景】：纯统计上报、遥测打点 (Telemetry)、纯广告追踪接口。
#    - 【机制特征】：客户端即使请求失败，也不影响核心业务流程，或者该业务本身没有降级重试逻辑。
#    - 【避坑禁忌】：绝不可用于核心网络库、初始化配置或 HTTPDNS 接口！一旦对 HTTPDNS 返回 404，
#      移动端网络引擎（OkHttp/Cronet/Mars/AMDC）会判定为“偶发网络故障 (Transient Network Failure)”，
#      立即启动指数退避高频重试（每隔数秒唤醒基带发热、打满日志），甚至弹窗警告“网络不稳定”。
#
# 2. 什么时候用 url reject-200 (HTTP 200 + 0 字节空 Body)？
#    - 【适用场景 1 - 纯文本/IP 列表】：如腾讯云/DNSPod 开放规范的 /d 接口 (119.29.29.29/d、拼多多、企微等)。
#      官方规范明确定义：/d 接口为纯文本传输，无记录或异常时返回空字符串，SDK 读取到空字符串后
#      自动触发官方兜底逻辑回退 LocalDNS。若误用 reject-dict，SDK 会将 "{}" 当作非法 IP 抛出校验异常。
#    - 【适用场景 2 - Protobuf 二进制协议】：如微信 micromsg-bin/newgetdns。
#      对于 Protobuf 类协议，空 Body 比注入 JSON 文本更安全（"{}" 可能因 Wire-Type 错误导致解码异常）；
#      如实测客户端将 200+空 Body 视为无 DNS 结果并回退 LocalDNS，则使用 reject-200。
#
# 3. 什么时候用 url reject-dict (HTTP 200 + 空 JSON 对象 {})？
#    - 【适用场景 - RESTful / JSON 响应】：如阿里 AMDC、字节 TTNet、京东、百度、B 站 P2P、美团、微博、知乎等。
#    - 【机制特征】：App 在收到 200 状态码后，会强制调用 JSON 解析器 (如 Android new JSONObject 或 iOS NSJSONSerialization)。
#      - 若返回 reject-200 (空字节)，会抛出 JSONException: End of input，SDK 视作“数据截断/报文损坏”，
#        从而继续轮询剩余的十几个备用 IP，重试风暴依然无法停止！
#      - 若返回 reject-dict ({})，JSON 反序列化顺利完成，SDK 读取到空结果后预期判定"无调度策略下发"，
#        进入正常休眠周期，不再发起重试，从而回退 LocalDNS。
#
# 4. (附) 什么时候用 url reject-array 与 reject-img？
#    - reject-array：接口期望返回 JSON 列表 (形如 [])，如某些广告列表、推荐流 API。
#    - reject-img：接口期望返回图片文件，返回 1x1 像素透明 GIF/PNG，防止 UI 渲染破图。
# -------------------------------------------------------------

[rewrite_local]
# =============================================================
# 分类 1: JSON 响应类接口 (全量使用 reject-dict 规避反序列化崩溃)
# =============================================================

# > Alipay (AMDC 阿里移动调度中心，涵盖域名与 12 个内置备用 IP 节点)
^https?:\/\/amdc\.alipay\.com\/s?query url reject-dict
^https?:\/\/amdc-sibling\.alipay\.com\.cn\/s?query url reject-dict
^https?:\/\/110\.76\.8\.150\/squery url reject-dict
^https?:\/\/203\.209\.230\.39\/squery url reject-dict
^https?:\/\/203\.209\.245\.102\/squery url reject-dict
^https?:\/\/203\.209\.245\.158\/squery url reject-dict
^https?:\/\/203\.209\.247\.95\/squery url reject-dict
^https?:\/\/203\.209\.250\.41\/squery url reject-dict
^https?:\/\/203\.209\.250\.114\/squery url reject-dict
^https?:\/\/203\.209\.251\.147\/squery url reject-dict
^https?:\/\/\[?2400:B180:6001::18F\]?\/squery url reject-dict
^https?:\/\/\[?2400:B200:1005:3000::155\]?\/squery url reject-dict
^https?:\/\/\[?2400:B200:1005:3000::1D3\]?\/squery url reject-dict
^https?:\/\/\[?2400:B200:5000:B000::C8\]?\/squery url reject-dict

# > Baidu (百度智能云 HTTPDNS v4 resolve 接口，文档规范为标准 JSON)
^http:\/\/180\.76\.76\.112\/v4\/resolve url reject-dict
^http:\/\/180\.76\.76\.220\/v4\/resolve url reject-dict

# > Bilibili (P2P HTTPDNS 解析节点，已知接口返回 JSON，使用 reject-dict 避免向 JSON 解析器注入空文本)
# KEY_EXT_P2P_HTTPDNS_BILI_IP
^http:\/\/47\.101\.175\.206\/resolve url reject-dict
^http:\/\/47\.100\.123\.169\/resolve url reject-dict
^http:\/\/120\.46\.169\.234\/resolve url reject-dict
^http:\/\/121\.36\.72\.124\/resolve url reject-dict
# KEY_EXT_P2P_BILIDNS_CMCC_IP
^http:\/\/116\.63\.10\.135\/resolve url reject-dict
^http:\/\/122\.9\.7\.134\/resolve url reject-dict
^http:\/\/117\.185\.228\.108\/resolve url reject-dict
^http:\/\/117\.144\.238\.29\/resolve url reject-dict
# KEY_EXT_P2P_BILIDNS_CT_IP
^http:\/\/122\.9\.13\.79\/resolve url reject-dict
^http:\/\/122\.9\.15\.129\/resolve url reject-dict
^http:\/\/101\.91\.140\.224\/resolve url reject-dict
^http:\/\/101\.91\.140\.124\/resolve url reject-dict
# KEY_EXT_P2P_BILIDNS_CU_IP
^http:\/\/114\.116\.215\.110\/resolve url reject-dict
^http:\/\/116\.63\.10\.31\/resolve url reject-dict
^http:\/\/112\.64\.218\.119\/resolve url reject-dict
^http:\/\/112\.65\.200\.117\/resolve url reject-dict

# > ByteDance (TTNet 网络库，返回空 dict 停止死循环重试探针，消除手机发热)
^https?:\/\/.+\.zijieapi\.com\/get_domains\/ url reject-dict

# > JD (京东 HTTPDNS，覆盖批量解析 /v6/b 与单域名 /v6/d，返回空 dict 避免开屏主线程反序列化异常)
^https:\/\/dns\.jd\.com\/v6\/[bd] url reject-dict

# > Meituan (美团/大众点评 HTTPDNS 接口，JSON 配置)
^http:\/\/103\.37\.155\.60\/fetch url reject-dict

# > Weibo (微博 HTTPDNS 接口，标准 JSON)
# refer: https://github.com/CNSRE/HTTPDNSLib-for-iOS
^http:\/\/api\.weibo\.cn\/2\/httpdns\/config url reject-dict
^http:\/\/api\.weibo\.cn\/httpdns\/config url reject-dict

# > Zhihu (知乎 HTTPDNS RESTful JSON 接口)
# refer: https://github.com/lwd-temp/anti-ip-attribution/issues/24
^http:\/\/103\.41\.167\.237\/v2\/resolv url reject-dict

# =============================================================
# 分类 2: 纯文本 / IP 列表类接口 (/d 规范，返回空 200 符合官方回退标准)
# =============================================================

# > QCloud (腾讯云移动解析 HTTPDNS)
# refer: https://mc.qcloudimg.com/static/qc_doc/d39d48b733835af8a2e223115ac67da7/doc-HttpDNS-Getting+Started.pdf
# refer: https://main.qcloudimg.com/raw/document/product/pdf/379_3513_cn.pdf
# refer: https://cloud.tencent.com/document/product/379/61200
^https?:\/\/119\.29\.29\.29\/d url reject-200

# > QQmusic (QQ 音乐专属调度，原版 182.256 系笔误，实测腾讯存活真实节点为 182.254.116.116)
^http:\/\/182\.25[46]\.116\.116\/d url reject-200

# > Wework (企业微信专属调度)
# refer: https://res.mail.qq.com/zh_CN/wework_ip/latest.html
^http:\/\/182\.254\.116\.117\/d url reject-200
^http:\/\/182\.254\.118\.119\/d url reject-200

# > Pinduoduo (拼多多采用腾讯云 HTTPDNS /d 协议)
^http:\/\/101\.35\.204\.35\/d url reject-200
^http:\/\/101\.35\.212\.35\/d url reject-200
^http:\/\/114\.110\.96\.26\/d url reject-200
^http:\/\/114\.110\.97\.97\/d url reject-200
^http:\/\/\[?240c:409f::3:0:163\]?\/d url reject-200
^http:\/\/\[?240c:409f::3:0:359\]?\/d url reject-200
^http:\/\/\[?2402:4e00:1411:201:0:9964:ba21:5a41\]?\/d url reject-200

# =============================================================
# 分类 3: Protobuf 二进制类接口 (微信，使用 reject-200 且严禁 MitM)
# =============================================================

# > Weixin (微信 HTTPDNS & CDN 调度，仅针对可能降级的 HTTP 请求进行静默拦截)
^https?:\/\/dns\.weixin\.qq\.com\/cgi-bin\/micromsg-bin\/newgetdns url reject-200
^https?:\/\/dns\.weixin\.qq\.com\.cn\/cgi-bin\/micromsg-bin\/newgetdns url reject-200
^https?:\/\/short\.weixin\.qq\.com\/cgi-bin\/micromsg-bin\/getcdndns url reject-200
^https?:\/\/hkextshort\.weixin\.qq\.com\/cgi-bin\/micromsg-bin\/getcdndns url reject-200

[mitm]
# 仅对支持标准 CA 证书解密的域名开启 MitM（严禁加入微信等自带 SSL Pinning 的域名）
hostname = amdc.alipay.com, amdc-sibling.alipay.com.cn, dns.jd.com, *.zijieapi.com
